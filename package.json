{
  "name": "ditto-assist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed:users": "tsx src/server/db/seedUsers.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill:ai-memory": "tsx scripts/backfillAiMemory.ts",
    "db:backfill:advisor-role": "tsx scripts/backfillAdvisorRole.ts",
    "db:backfill:advisor-tags-csv": "tsx scripts/assignAdvisorTagsFromCsv.ts",
    "db:import:qa-history": "tsx scripts/importQaEvaluationHistory.ts",
    "db:fix:gallbladder-category": "tsx scripts/fixGallbladderCategory.ts",
    "db:seed:kb-pdfs": "tsx scripts/seedKnowledgeBasePdfs.ts",
    "db:seed:kb-urls": "tsx scripts/seedKnowledgeBaseUrls.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
