# Files/dirs not needed inside the Cloud Build upload for `gcloud run deploy
# --source .` — keeps the upload small so the "Uploading sources..." step
# doesn't drag. The Docker build regenerates dist/ itself, so none of this
# needs to travel with the source.

.git
.gcloudignore
.gitignore
.dockerignore
.github

# Dependencies — reinstalled fresh inside the Docker build
node_modules
node_modules_*

# Build output — regenerated by the Docker build
dist/
build/
coverage/

# Knowledge Base source PDFs — 40MB+ of documents that live on this machine
# only, ingested into Postgres via `npm run db:seed:kb-pdfs -- --commit`.
# Never read by the running app, so it never needs to leave this machine.
Product Assist/

# Env files — real values come from --env-vars-file, not the container
.env
.env.local
.env.staging
.env.production
!.env.example

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp

# Docs, reports, and governance markdown — not needed at runtime
*.md
migration-reports/
docs/

# Tests
playwright-report/
test-results/
src/__tests__/
