# Environment variables for the Declaration Assistant WebApp.
# Copy this file to .env and fill in real values — .env is git-ignored and
# never committed (see .gitignore). Every variable below is read directly
# from process.env somewhere in server.ts / src/server/**.

# --- Core ---

# NODE_ENV: "development" locally (npm run dev), "production" when running
# the built server (npm start / deployed host). Controls secure-cookie
# flags and whether Vite runs in middleware mode vs. serving dist/.
NODE_ENV="development"

# PORT: local dev server port. Most hosts (Cloud Run, Render, etc.) set
# this automatically at runtime — you can leave it unset in production.
# Cloud Run automatically provides PORT.
# Do not set PORT in production unless required.
PORT="3000"

# APP_URL: the externally-reachable URL of this app. Used to build the
# Google OAuth redirect URI ({APP_URL}/api/auth/google/callback). Locally
# this is your dev server URL; in production, set it to your deployed URL.
# Development:
APP_URL="http://localhost:3000"
# Production:
APP_URL="https://your-app.run.app"

# DATABASE_URL: Postgres connection string (Neon, Supabase, RDS, etc).
# Required — getDb() throws on first use if this is missing.
# Example (Neon):
# postgresql://username:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://username:password@host.neon.tech/dbname?sslmode=require"

# GEMINI_API_KEY: from Google Cloud Console > APIs & Services >
# Credentials. Powers AI-assisted category mapping refinement; optional —
# falls back to keyword matching if unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PED_SOURCE: "db" (default as of Phase 5, 2026-07-28) or "legacy".
# Controls which PED classification source classifyDeterministic() reads:
#   "db"     — ped_repository/ped_aliases/plan_overrides in Postgres (the
#              governed PED Repository). Production default since Phase 5's
#              cutover validation (Checkpoint B) was signed off with 0
#              unexplained differences against legacy.
#   "legacy" — the original hardcoded TOP_PED_DICTIONARY + regex blocks in
#              engine.ts. Kept in the codebase indefinitely as an emergency
#              rollback path — set this to "legacy" and restart, no
#              redeploy needed, if the DB-backed path ever misbehaves.
# Unset or any other value is treated as "legacy".
PED_SOURCE="db"

# --- Google Workspace authentication ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0
# Client IDs (Web application type). Authorized redirect URI must be
# exactly: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# SESSION_SECRET: random, high-entropy string used to sign session cookies
# (HMAC-SHA256). Generate with: openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
SESSION_SECRET="MY_SESSION_SECRET"

# --- Google Groups RBAC — NOT IMPLIMENTED YET, leave as placeholders ---
# GOOGLE_ADMIN_SDK_SUBJECT: the Workspace admin email a domain-wide-delegated
# service account impersonates to call the Admin SDK Directory API (needed
# to read Declaration-Owners / Declaration-Admins / All-Ditto membership).
# GOOGLE_APPLICATION_CREDENTIALS: path to that service account's JSON key.
# Neither is read by any code today — reserved for a future phase.
GOOGLE_ADMIN_SDK_SUBJECT="admin@joinditto.in"
GOOGLE_APPLICATION_CREDENTIALS="MY_SERVICE_ACCOUNT_KEY_PATH.json"

# --- QA Dashboard (src/server/qaDashboard/**) ---
# RECOMMENDED SETUP NEEDS NONE OF THE VARS BELOW: click "Connect Google
# Sheets" in Developer Controls (Owner Controls page) while signed in as
# someone who already has access to the QA team's Sheet — this stores an
# encrypted refresh token in Postgres (qa_dashboard_google_connection table)
# and needs no service account, no Workspace admin, no env vars at all.
# See QA_DASHBOARD_SHEETS_SETUP.md.
#
# The vars below are only for the ALTERNATIVE service-account path (useful
# if you specifically want a machine identity instead of a real person's
# OAuth grant — e.g. so the connection doesn't depend on any one person's
# Google account). This is a SEPARATE service account from
# GOOGLE_APPLICATION_CREDENTIALS above — that one is reserved for future
# Admin SDK use; this one only ever needs (and should only ever be granted)
# read-only access to the QA team's Google Sheet.

# Set exactly ONE of these two:
# QA_DASHBOARD_GOOGLE_SERVICE_ACCOUNT_KEY: the full contents of the service
# account's JSON key file, pasted as a single-line string. Handy for hosts
# where you set secrets as env vars (e.g. Cloud Run) rather than files.
QA_DASHBOARD_GOOGLE_SERVICE_ACCOUNT_KEY=""
# QA_DASHBOARD_GOOGLE_SERVICE_ACCOUNT_KEY_PATH: path to that same JSON key
# file on disk. Handy for local dev. Leave the other one blank if you use this.
QA_DASHBOARD_GOOGLE_SERVICE_ACCOUNT_KEY_PATH="MY_QA_DASHBOARD_SERVICE_ACCOUNT_KEY_PATH.json"

# QA_DASHBOARD_IMPERSONATE_SUBJECT: a real @joinditto.in email the service
# account impersonates via domain-wide delegation, instead of the sheet
# being shared directly with the service account's own email. Needed if
# your Workspace's external-sharing policy blocks sharing with a service
# account (error: "prohibits the sharing of items with ... not a Google
# Account in a compatible allowlisted domain") — see
# QA_DASHBOARD_SHEETS_SETUP.md. Leave blank if direct sharing worked instead.
QA_DASHBOARD_IMPERSONATE_SUBJECT="mehruf.p@joinditto.in"

# --- Product Assist Log Export (TEMPORARY — src/server/knowledgeBase/queryAssistLog*) ---
# A knowingly time-boxed exception to Product Assist's normal "no
# server-side record of conversations" design, added to build a real test
# set for the Product Assist optimization review. See
# query_assist_logs's schema comment in src/server/db/schema.ts.

# QUERY_ASSIST_LOG_ENABLED: "false" turns off the temporary logging entirely
# (nothing new is written to query_assist_logs). Unset, or any other value,
# means enabled. Set this to "false" once you've collected enough data —
# no other change needed, no redeploy required beyond restarting with the
# new value.
QUERY_ASSIST_LOG_ENABLED="true"

# QUERY_ASSIST_LOG_SHEET_ID: the Google Sheet's ID (the long string in its
# URL between /d/ and /edit) that logged rows get exported to. Create the
# Sheet yourself first, then set this — required before the first export.
QUERY_ASSIST_LOG_SHEET_ID="MY_GOOGLE_SHEET_ID"

# QUERY_ASSIST_LOG_SHEET_TAB_NAME: which tab/sheet within that spreadsheet
# to append to. Defaults to "Sheet1" (a brand-new Sheet's default tab name)
# if unset.
QUERY_ASSIST_LOG_SHEET_TAB_NAME="Sheet1"

# QUERY_ASSIST_LOG_EXPORT_SECRET: a random, high-entropy string (generate
# with: openssl rand -base64 32) that lets an external scheduler (e.g.
# Google Cloud Scheduler) trigger POST /api/query-assist-logs/export-and-clear
# by sending it as an X-Cron-Secret header, without needing a real user
# session. Leave unset if you only ever want to trigger the export manually
# ("Export & Clear Now" in Connections, signed in as Admin/Developer) — the
# route still works via a normal session either way.
QUERY_ASSIST_LOG_EXPORT_SECRET=""

# Role rosters — REMOVED as of the 2026-07-30 cutover (drizzle/
# 0022_qa_dashboard_roles.sql). Admin/Guide/Mentor access is now managed
# entirely from the UI: User Directory & Management -> "QA Dashboard Access"
# tab (Admin or Developer tier). These env vars are no longer read anywhere
# in the code — the migration backfilled the exact membership they held at
# cutover into the qa_dashboard_roles table, so nothing needs to be copied
# here. Safe to delete QA_ADMIN_EMAILS / QA_GUIDE_EMAILS / QA_GUIDE_NAME_MAP /
# QA_MENTOR_EMAILS / QA_MENTOR_NAME_MAP from any environment (local .env,
# Cloud Run, etc.) whenever convenient.
